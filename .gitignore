*.py[cod]
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Environments
.venv/
venv/
.python-version

# uv
uv.lock.bak

# Project data — never commit large binary artifacts
datasets/raw/*
