datasets/processed/*
!datasets/processed/.gitkeep
datasets/manifests/*.json
weights/*
!weights/.gitkeep
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
experiments/*
!experiments/.gitkeep

# TensorBoard / training runs
runs/
*.ckpt
*.pt
*.pth
*.onnx

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Local overrides
configs/local.yaml
.env
